{
  "manifest_version": 3,
  "name": "RIP Translator",
  "version": "1.3.0",
  "description": "Real-time subtitle translation for online courses (Udemy, gamedev.tv, Domestika, and more)",
  "permissions": [
    "storage",
    "activeTab",
    "downloads"
  ],
  "host_permissions": [
    "https://www.udemy.com/*",
    "https://gamedev.tv/*",
    "https://iframe.mediadelivery.net/*",
    "https://www.domestika.org/*",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.udemy.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gamedev.tv/*",
        "https://iframe.mediadelivery.net/*"
      ],
      "js": ["gamedev.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://www.domestika.org/*"],
      "js": ["domestika.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
